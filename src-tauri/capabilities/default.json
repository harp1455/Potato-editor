{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "편집기 화면에 허용하는 기능",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-copy-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    "dialog:default",
    "upload:default",
    "process:default",
    "updater:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://127.0.0.1:*/*"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://localhost:*/*"
        }
      ]
    }
  ]
}