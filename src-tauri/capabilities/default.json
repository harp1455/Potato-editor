{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "편집기 화면에 허용하는 기능",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-read-dir",
    "dialog:default",
    "upload:default",
    "process:default",
    "updater:default"
  ]
}
